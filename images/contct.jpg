@keyframes attentionPulse {=20
  0%, 20%, 40%, 60%, 80%, 100% { transform: scale(1); }
  10%, 30%, 50%, 70%, 90% { transform: scale(3); }
}

.animate-attentionPulse { animation: 10s ease 0s infinite normal none runni=
ng attentionPulse; }

@keyframes attentionPulseInner {=20
  0%, 20%, 40%, 60%, 80%, 100% { transform: scale(1); }
  10%, 30%, 50%, 70%, 90% { transform: scale(2); }
}

.animate-attentionPulseInner { animation: 10s ease 0s infinite normal none =
running attentionPulseInner; }

@keyframes fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.animate-fade-in { animation: 0.2s ease-out 0s 1 normal none running fade-i=
n; }

@keyframes overlayShow {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.animate-overlayShow { animation: 0.15s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 =
normal none running overlayShow; }

@keyframes pulse {=20
  50% { opacity: 0.5; }
}

.animate-pulse { animation: 2s cubic-bezier(0.4, 0, 0.6, 1) 0s infinite nor=
mal none running pulse; }

@keyframes scroll-horizontal {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

.animate-scroll-horizontal { animation: 20s linear 0s infinite normal none =
running scroll-horizontal; }

@keyframes spin {=20
  100% { transform: rotate(1turn); }
}

.animate-spin { animation: 1s linear 0s infinite normal none running spin; =
}

