}
  .motion-safe\:animate-twinkle { animation: 2.6s ease-in-out 0s infinite n=
ormal none running twinkle; }
  .motion-safe\:transition-opacity { transition-property: opacity; transiti=
on-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 0.15=
s; }
}

